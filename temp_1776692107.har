lessService:20026,checksConsentlessRegister:\"/datos-adicionales/obtener-acceso-servicio-usuario\",activeConsentlessRegister:\"/datos-adicionales/guardar-acceso-servicio-usuario\"},cookie_consentState:{nameCookie:\"ue_consentState\",hoursToExpired:1,steps:{first:1,firstLogin:1.1,optionsPage:2,twoPointOne:2.1,twoPointTwo:2.2,twoPointThree:2.3}},cookie_ueUserInformationChecks:{nameCookie:\"ueUserInformationChecks\",fallback:{maxAge:3600,value:2},consentAccepted:{maxAge:3600,value:4},consentRejected:{maxAge:3600,value:8},consentPrevious:{maxAge:3600,value:16}},analitycs:{clientSubscriptionPackage:\"Marca. Acceso sin consentimiento 14,99€/año\",endpointDidomiEvents:\"https://api.privacy-center.org/v1/events\"},iab:{vendorsListUrl:\"https://components.unidadeditorial.es/vendor-list.json\"},amp:{cookie_ueAmpConsentAccepted:{nameCookie:\"ueAmpConsentAccepted\",maxAge:432e3},cookie_ueAmpParentHref:{nameCookie:\"ueAmpParentHref\",maxAge:300},nameStaticUrl:\"https://www.marca.com/assets/consent/v1/amp-consent-mar.html\"}},a={8:{portal:\"elmundo\",textContent:{default:{es:{didomiModal:{header:{loginQuestion:\"¿Eres suscriptor?\",loginLink:\"Iniciar sesión\",changeAccountLink:\"Cambiar cuenta\"},saveButtonText:\"Guardar y continuar\",disagreeAndSuscribeButtonText:\"Rechazar y suscribirse\",disagreeButtonText:\"Rechazar\",configureButtonText:\"Configurar\"},ueModal:{header:{loginQuestion:\"¿Eres suscriptor?\",loginLink:\"Iniciar sesión\",changeAccountLink:\"Cambiar cuenta\",mainText:\"Has elegido rechazar las cookies basadas en consentimiento que utilizamos principalmente para gestionar la publicidad y las recomendaciones de contenido. En adelante, <strong>para acceder a nuestra web tienes que elegir alguna de las siguientes opciones.</strong>\"},offers:{consentless:{title:\"Acceso rechazando cookies\",infoText:\"Permite navegar por El Mundo sin cookies basadas en consentimiento, pero con acceso limitado a los artículos gratuitos.\",buttonText:\"Accede por 14,99€ al año\",hintText:\"Cancela cuando quieras\"},premium:{buttonText:\"Ver otras opciones de suscripción\"}},footer:{infoText:\"Si has cambiado de idea, <strong>puedes aceptar las cookies y continuar leyendo EL MUNDO.</strong>\",acceptButtton:\"Acepta y accede a EL MUNDO\",legalText:\"<strong>Nosotros y nuestros socios hacemos el siguiente tratamiento de datos:</strong> Almacenamiento y acceso a información de geolocalización con propósitos de publicidad dirigida, Almacenamiento y acceso a información de geolocalización para realizar estudios de mercado, Almacenar o acceder a información en un dispositivo, Analizar activamente las características del dispositivo para su identificación, Compartir tus análisis de navegación y grupos de interés con terceros, Crear un perfil para la personalización de contenidos, Crear un perfil publicitario personalizado, Desarrollar y mejorar productos, Enriquecer el perfil con información de terceros, Medir el rendimiento de los anuncios, Medir el rendimiento del contenido, Seleccionar anuncios básicos, Seleccionar anuncios personalizados, Seleccionar contenido personalizado, Utilizar datos de localización geográfica precisa, Utilizar estudios de mercado a fin de generar información sobre el público\"},accessibility:{ueModalAriaLabel:\"Rechazo de cookies y suscripción\",offersAriaLabel:\"Opciones de pago\",offerOneAriaLabel:\"Opción 1\",offerTwoAriaLabel:\"Opción 2\"}}},en:{didomiModal:{header:{loginQuestion:\"Are you a subscriber?\",loginLink:\"Login\",changeAccountLink:\"Change account\"},saveButtonText:\"Save and continue\",disagreeAndSuscribeButtonText:\"Reject and subscribe\",disagreeButtonText:\"Reject\",configureButtonText:\"Configuration\"},ueModal:{header:{loginQuestion:\"¿Eres suscriptor?\",loginLink:\"Iniciar sesión\",changeAccountLink:\"Cambiar cuenta\",mainText:\"Has elegido rechazar las cookies basadas en consentimiento que utilizamos principalmente para gestionar la publicidad y las recomendaciones de contenido. En adelante, <strong>para acceder a nuestra web tienes que elegir alguna de las siguientes opciones.</strong>\"},offers:{consentless:{title:\"Acceso rechazando cookies\",infoText:\"Permite navegar por El Mundo sin cookies basadas en consentimiento, pero con acceso limitado a los artículos gratuitos.\",buttonText:\"Accede por 14,99€ al año\",hintText:\"Cancela cuando quieras\"},premium:{buttonText:\"Ver otras opciones de suscripción\"}},footer:{infoText:\"Si has cambiado de idea, <strong>puedes aceptar las cookies y continuar leyendo EL MUNDO.</strong>\",acceptButtton:\"Acepta y accede a EL MUNDO\",legalText:\"<strong>Nosotros y nuestros socios hacemos el siguiente tratamiento de datos:</strong> Almacenamiento y acceso a información de geolocalización con propósitos de publicidad dirigida, Almacenamiento y acceso a información de geolocalización para realizar estudios de mercado, Almacenar o acceder a información en un dispositivo, Analizar activamente las características del dispositivo para su identificación, Compartir tus análisis de navegación y grupos de interés con terceros, Crear un perfil para la personalización de contenidos, Crear un perfil publicitario personalizado, Desarrollar y mejorar productos, Enriquecer el perfil con información de terceros, Medir el rendimiento de los anuncios, Medir el rendimiento del contenido, Seleccionar anuncios básicos, Seleccionar anuncios personalizados, Seleccionar contenido personalizado, Utilizar datos de localización geográfica precisa, Utilizar estudios de mercado a fin de generar información sobre el público\"},accessibility:{ueModalAriaLabel:\"Rechazo de cookies y suscripción\",offersAriaLabel:\"Opciones de pago\",offerOneAriaLabel:\"Opción 1\",offerTwoAriaLabel:\"Opción 2\"}}}}}},2:{portal:\"marca\",textContent:{default:{es:{didomiModal:{header:{loginQuestion:\"¿Ya tienes cuenta?\",loginLink:\"Inicia sesión\",changeAccountLink:\"Cambiar cuenta\"},saveButtonText:\"Guardar y continuar\",disagreeAndSuscribeButtonText:\"Rechazar y suscribirse\",disagreeButtonText:\"Rechazar\",configureButtonText:\"Configurar\"},ueInitialModal:{loginQuestion:\"¿Eres suscriptor?\",loginLink:\"Inicia sesión\",changeAccountLink:\"Cambiar cuenta\",firstText:'<p>Pulsando <span class=\"highlight\">\"Acepto y continúo gratis\"</span> accedes de forma <span class=\"highlight\">gratuita</span> y <span class=\"highlight\">consientes la instalación de cookies</span> propias y de nuestros socios que permiten el seguimiento y análisis de tu comportamiento en el sitio web, así como desarrollar un perfil específico para mostrarte publicidad y contenido personalizado en función del mismo, permitiéndonos financiar nuestra actividad.</p> <p>Puedes consultar nuestros socios pulsando <button data-analytics=\"Nuestros Socios_2\" action-name=\"openDidomiVendors\">aquí</button>. Puedes consultar más información en nuestra <a href=\"javascript:void(0);\" data-analytics=\"Política de Cookies_2\" action-name=\"redirectCookiePolicy\">Política de Cookies</a> y retirar en cualquier momento el consentimiento pulsando el botón  <button data-analytics=\"Configuración de Cookies_2\" action-name=\"openDidomiPurposes\">Configuración de Cookies</button> que aparece disponible en el pie de nuestro sitio web.</p>',secondText:'<p>Pulsando <span class=\"highlight\">\"Rechazo y me suscribo\" no autorizas la instalación de cookies y decides acceder mediante la suscripción <i>cookieless</i>.</span> En este caso, solo se instalarán cookies que sean necesarias para garantizar la navegación.</p> <p>Si accedes mediante esta opción, no se utilizarán cookies para analizar el comportamiento ni para mostrar publicidad o contenido personalizado, aunque sí podrás visualizar publicidad general no personalizada.</p> <p>Puedes rechazar la instalación de cookies y acceder a nuestro sitio web a través de esta suscripción <i>cookieless</i> pulsando el botón \"Rechazo y me suscribo\".</p>',firstBtnText:\"Acepto y continúo gratis\",secondBtnText:\"Rechazo y me suscribo\",thirdBtnText:\"Rechazar\",cookiePolicy:\"Política de Cookies\",cookieSettings:\"Configuración de Cookies\",ourPartners:\"Nuestros Socios\",thirdPartyTexts:{cookieSettings:\"Configuración de Cookies\",firstText:'<p>Pulsando <span class=\"highlight\">\"Aceptar\" consientes la instalación de cookies</span> propias y de nuestros socios que permiten el seguimiento y análisis de tu comportamiento en el sitio web, así como desarrollar un perfil específico para mostrarte publicidad y contenido personalizado en función del mismo, permitiéndonos financiar nuestra actividad.</p><p>Puedes consultar nuestros socios pulsando <button action-name=\"openDidomiVendors\">aquí</button> y consultar más información en nuestra <a href=\"javascript:void(0);\" action-name=\"redirectCookiePolicy\">Política de Cookies</a>. Asimismo, puedes configurar la instalación de cookies, o retirar en cualquier momento tu consentimiento, pulsando el botón <button action-name=\"openDidomiPurposes\">Configurar Cookies</button> que está disponible en el encabezado de este aviso, así como en el pie de nuestro sitio web. </p>',secondText:'<p>Pulsando <span class=\"highlight\">\"Rechazar\" no consientes la instalación de cookies</span>. En este caso, solo se instalarán cookies que sean necesarias para garantizar la navegación. Si accedes mediante esta opción, no se utilizarán cookies para analizar el comportamiento ni para mostrar publicidad o contenido personalizado, aunque sí podrás visualizar publicidad general no personalizada. </p>',firstBtnText:\"Aceptar\",secondBtnText:\"Rechazar\",cookiePolicy:\"Política de Cookies\",ourPartners:\"Nuestros Socios\"},accessibility:{ueInitialModalAriaLabel:\"Gestión de cookies\"}},ueModal:{header:{loginQuestion:\"¿Ya tienes cuenta?\",loginLink:\"Inicia sesión\",changeAccountLink:\"Cambiar cuenta\",mainText:\"<strong>Has elegido rechazar las cookies basadas en consentimiento</strong> que utilizamos, principalmente, para gestionar la publicidad y las recomendaciones de contenido. En adelante, <strong>para acceder a nuestra web tienes que elegir alguna de las siguientes opciones.</strong>\",mainTextRegisterExpired:\"<strong> Has disfrutado de la posibilidad de navegar sin cookies</strong> basadas en el consentimiento durante 5 días, para continuar disfrutando de MARCA <strong>te pedimos que te suscribas a la propuesta</strong> que te hacemos a continuación:\"},offers:{consentlessRegister:{title:\"Acceso con registro\",buttonText:\"Regístrate\",buttonTextLogged:\"Entrar\",infoText:\"Regístrate en la web de MARCA y navega durante 5 días sin aceptar las cookies.\",infoTextLogged:\"Ya estas registrado en nuestra web, disfruta de 5 días de la información de MARCA sin aceptar las cookies.\",hintText:\"Tras este periodo te volveremos a preguntar\"},consentless:{title:\"Acceso rechazando cookies\",infoText:\"Permite navegar por MARCA sin cookies basadas en consentimiento.\",buttonText:\"Accede por 14,99€ al año\",hintText:\"<strong>Sin compromiso</strong>, cancela en cualquier momento\"}},footer:{infoText:\"O si has cambiado de idea, <strong>puedes aceptar las cookies</strong> y continuar leyendo MARCA.\",acceptButtton:\"Acepta y accede a MARCA\",legalText:\"<strong>Nosotros y nuestros socios hacemos el siguiente tratamiento de datos:</strong> Almacenamiento y acceso a información de geolocalización con propósitos de publicidad dirigida, Almacenamiento y acceso a información de geolocalización para realizar estudios de mercado, Almacenar o acceder a información en un dispositivo, Analizar activamente las características del dispositivo para su identificación, Compartir tus análisis de navegación y grupos de interés con terceros, Crear un perfil para la personalización de contenidos, Crear un perfil publicitario personalizado, Desarrollar y mejorar productos, Enriquecer el perfil con información de terceros, Medir el rendimiento de los anuncios, Medir el rendimiento del contenido, Seleccionar anuncios básicos, Seleccionar anuncios personalizados, Seleccionar contenido personalizado, Utilizar datos de localización geográfica precisa, Utilizar estudios de mercado a fin de generar información sobre el público\"},accessibility:{ueModalAriaLabel:\"Rechazo de cookies y suscripción\",offersAriaLabel:\"Opciones de pago\",offerOneAriaLabel:\"Opción 1\",offerTwoAriaLabel:\"Opción 2\"}}},en:{didomiModal:{header:{loginQuestion:\"Have an account?\",loginLink:\"Login\",changeAccountLink:\"Change account\"},saveButtonText:\"Save and continue\",disagreeAndSuscribeButtonText:\"Reject and subscribe\",disagreeButtonText:\"Reject\",configureButtonText:\"Configuration\"},ueInitialModal:{loginQuestion:\"Are you a subscriber?\",loginLink:\"Login\",changeAccountLink:\"Change account\",firstText:'<p>By clicking <span class=\"highlight\">\"I accept and continue for free\"</span>, you access for free and <span class=\"highlight\">consent to the installation of cookies</span> from us and our partners, which enable tracking and analysis of your behaviour on the website, as well as the development of a specific profile to show you advertising and personalized content based on it, allowing us to finance our activity.</p> <p>You can view our partners by clicking <button data-analytics=\"Our Partners_2\" action-name=\"openDidomiVendors\">here</button>. You can find more information in our <a href=\"javascript:void(0);\" data-analytics=\"Cookie Policy_2\" action-name=\"redirectCookiePolicy\">Cookie Policy</a> and withdraw your consent at any time by clicking the <button data-analytics=\"Cookie Settings_2\" action-name=\"openDidomiPurposes\">Cookie Settings</button> button available at the footer of our website.</p>',secondText:'<p>By clicking <span class=\"highlight\">\"I reject and subscribe\", you do not allow the installation of cookies and choose to access via the <i>cookieless</i> subscription.</span> In this case, only cookies necessary for navigation will be installed.</p> <p>If you access through this option, cookies will not be used to analyse behaviour or display personalized advertising or content. Nevertheless, you will still see general, non-personalized advertising.</p> <p>You can reject the installation of cookies and access our website through this <i>cookieless</i> subscription by clicking the \"I reject and subscribe\" button.</p>',firstBtnText:\"I accept and continue for free\",secondBtnText:\"I reject and subscribe\",thirdBtnText:\"Reject\",cookiePolicy:\"Cookie Policy\",cookieSettings:\"Cookie Settings\",ourPartners:\"Our Partners\",thirdPartyTexts:{cookieSettings:\"Cookie Settings\",firstText:'<p>By clicking <span class=\"highlight\">\"Accept\"</span>, you <span class=\"highlight\">consent to the installation of cookies</span> from us and our partners, which enable tracking and analysis of your behavior on the website, as well as the development of a specific profile to show you advertising and personalized content based on it, allowing us to finance our activity.</p><p>You can view our partners by clicking <button action-name=\"openDidomiVendors\">here</button> and you can find more information in our <a href=\"javascript:void(0);\" action-name=\"redirectCookiePolicy\">Cookie Policy</a>. You can also set your preference and withdraw your consent at any time by clicking the <button action-name=\"openDidomiPurposes\">Cookie Settings</button> button available at the top of this notice and at the footer of our website</p>',secondText:'<p>By clicking <span class=\"highlight\">\"Reject\"</span> you do not consent to the installation of cookies. In this case, only cookies that are strictly necessary for browsing will be installed.If you choose this option, cookies will not be used to analyze your behavior or to display personalized advertising or content, although you will still see general, non-personalized ads.</p>',firstBtnText:\"Accept\",secondBtnText:\"Reject\",cookiePolicy:\"Cookie Policy\",ourPartners:\"Our Partners\"},accessibility:{ueInitialModalAriaLabel:\"Cookie management\"}},ueModal:{header:{loginQuestion:\"Have an account?\",loginLink:\"Login\",changeAccountLink:\"Change account\",mainText:\"<strong>You have chosen to reject consent-based cookies</strong>, which we mainly use to manage advertising and content recommendations. From now on, <strong>to access our website, you must choose one of the following options:</strong>\",mainTextRegisterExpired:\"<strong>You have enjoyed the possibility of browsing without consent-based cookies</strong> for 5 days. To continue enjoying marca, <strong>we ask that you subscribe</strong> to the following option:\"},offers:{consentlessRegister:{title:\"Access with registration\",buttonText:\"Register\",buttonTextLogged:\"Access\",infoText:\"Register on MARCA’s website and browse for 5 days without accepting cookies.\",infoTextLogged:\"You’re already registered on our website. Enjoy 5 days of MARCA content without accepting cookies.\",hintText:\"After this period, we will ask you again\"},consentless:{title:\"Access by rejecting cookies\",infoText:\"Allows you to browse MARCA without consent-based cookies.\",buttonText:\"Access for €14.99/year\",hintText:\"<strong>No commitment</strong>, cancel anytime.\"}},footer:{infoText:\"Or, <strong>if you’ve changed your mind, you can accept cookies</strong> and continue reading MARCA.\",acceptButtton:\"Accept and access MARCA\",legalText:\"<strong>We and our partners process data as follows:</strong> Storage and access to geolocation information for targeted advertising purposes, storage and access to geolocation information for market research, storing or accessing information on a device, actively analyzing device characteristics for identification, sharing your browsing analysis and interest groups with third parties, creating a profile for content personalization, creating a personalized advertising profile, developing and improving products, enriching the profile with information from third parties, measuring ad performance, measuring content performance, selecting basic ads, selecting personalized ads, selecting personalized content, using precise geolocation data, and using market research to generate audience insights.\"},accessibility:{ueModalAriaLabel:\"Refusal of cookies and subscription\",offersAriaLabel:\"Payment options\",offerOneAriaLabel:\"Option 1\",offerTwoAriaLabel:\"Option 2\"}}}},US:{es:{didomiModal:{header:{loginQuestion:\"¿Ya tienes cuenta?\",loginLink:\"Inicia sesión\",changeAccountLink:\"Cambiar cuenta\"},saveButtonText:\"Guardar y continuar\",disagreeAndSuscribeButtonText:\"Rechazar y suscribirse\",disagreeButtonText:\"Rechazar\",configureButtonText:\"Configurar\"},ueInitialModal:{loginQuestion:\"¿Eres suscriptor?\",loginLink:\"Inicia sesión\",changeAccountLink:\"Cambiar cuenta\",firstText:\"<p>MARCA y nuestros socios utilizan cookies y tecnologías de seguimiento para analizar y medir su comportamiento cuando navega por nuestro sitio web, así como para ofrecerle contenidos y publicidad personalizados en función de su perfil individual. La información podrá comunicarse a terceros, como empresas de publicidad y analítica, e incluir el título de los vídeos que usted haya visualizado.</p>\",secondText:\"<p>Al pulsar “Aceptar”, usted consiente la instalación de estas cookies. Al pulsar “Rechazar”, podrá acceder al sitio web mediante una suscripción sin cookies.</p>\",firstBtnText:\"Aceptar\",secondBtnText:\"Rechazar\",thirdBtnText:\"Rechazar\",cookiePolicy:\"Política de Cookies\",cookieSettings:\"Configuración de Cookies\",ourPartners:\"Nuestros Socios\",accessibility:{ueInitialModalAriaLabel:\"Gestión de cookies\"}},ueModal:{header:{loginQuestion:\"¿Ya tienes cuenta?\",loginLink:\"Inicia sesión\",changeAccountLink:\"Cambiar cuenta\",mainText:\"<strong>Has elegido rechazar las cookies basadas en consentimiento</strong> que utilizamos, principalmente, para gestionar la publicidad y las recomendaciones de contenido. En adelante, <strong>para acceder a nuestra web tienes que elegir alguna de las siguientes opciones.</strong>\",mainTextRegisterExpired:\"<strong> Has disfrutado de la posibilidad de navegar sin cookies</strong> basadas en el consentimiento durante 5 días, para continuar disfrutando de MARCA <strong>te pedimos que te suscribas a la propuesta</strong> que te hacemos a continuación:\"},offers:{consentlessRegister:{title:\"Acceso con registro\",buttonText:\"Regístrate\",buttonTextLogged:\"Entrar\",infoText:\"Regístrate en la web de MARCA y navega durante 5 días sin aceptar las cookies.\",infoTextLogged:\"Ya estas registrado en nuestra web, disfruta de 5 días de la información de MARCA sin aceptar las cookies.\",hintText:\"Tras este periodo te volveremos a preguntar\"},consentless:{title:\"Acceso rechazando cookies\",infoText:\"Permite navegar por MARCA sin cookies basadas en consentimiento.\",buttonText:\"Accede por 14,99€ al año\",hintText:\"<strong>Sin compromiso</strong>, cancela en cualquier momento\"}},footer:{infoText:\"O si has cambiado de idea, <strong>puedes aceptar las cookies</strong> y continuar leyendo MARCA.\",acceptButtton:\"Acepta y accede a MARCA\",legalText:\"<strong>Nosotros y nuestros socios hacemos el siguiente tratamiento de datos:</strong> Almacenamiento y acceso a información de geolocalización con propósitos de publicidad dirigida, Almacenamiento y acceso a información de geolocalización para realizar estudios de mercado, Almacenar o acceder a información en un dispositivo, Analizar activamente las características del dispositivo para su identificación, Compartir tus análisis de navegación y grupos de interés con terceros, Crear un perfil para la personalización de contenidos, Crear un perfil publicitario personalizado, Desarrollar y mejorar productos, Enriquecer el perfil con información de terceros, Medir el rendimiento de los anuncios, Medir el rendimiento del contenido, Seleccionar anuncios básicos, Seleccionar anuncios personalizados, Seleccionar contenido personalizado, Utilizar datos de localización geográfica precisa, Utilizar e