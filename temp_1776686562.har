fono en el que se aprecian las lentes de la cámara. Aparece un S Pen delante del dispositivo.Galaxy AI\\\",\\\"thumbnailUrl\\\":\\\"https://images.samsung.com/is/image/samsung/assets/es/s2602/home/HOME_Hero-KV_Galaxy-S26-Ultra_PC_1920x1080_LTR.jpg\\\",\\\"contentUrl\\\":\\\"https://images.samsung.com/is/content/samsung/assets/es/s2602/home/HOME_Hero-KV_Galaxy-S26-Ultra_PC_1920x1080_LTR.mp4\\\",\\\"inLanguage\\\":\\\"es-ES\\\",\\\"publisher\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Samsung\\\",\\\"logo\\\":{\\\"@type\\\":\\\"ImageObject\\\",\\\"url\\\":\\\"https://www.samsung.com/etc.clientlibs/samsung/clientlibs/consumer/global/clientlib-common/resources/images/logo-square-letter.png\\\"},\\\"@id\\\":\\\"https://www.samsung.com/es/#org\\\"}},{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"VideoObject\\\",\\\"uploadDate\\\":\\\"2026-04-14T17:49:17.742+09:00\\\",\\\"name\\\":\\\"The door is open  Step into Vision AI\\\",\\\"description\\\":\\\"The door is open Step into Vision AI\\\",\\\"datePublished\\\":\\\"\\\",\\\"dateModified\\\":\\\"\\\",\\\"inLanguage\\\":\\\"es-ES\\\",\\\"publisher\\\":{\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Samsung\\\",\\\"logo\\\":{\\\"@type\\\":\\\"ImageObject\\\",\\\"url\\\":\\\"https://www.samsung.com/etc.clientlibs/samsung/clientlibs/consumer/global/clientlib-common/resources/images/logo-square-letter.png\\\"},\\\"@id\\\":\\\"https://www.samsung.com/es/#org\\\"},\\\"thumbnailUrl\\\":\\\"https://images.samsung.com/is/image/samsung/assets/es/home/04-2026/2026-vd-2nd-handsaiser-feature-kv-pc.jpg?$1440_N_JPG$\\\",\\\"contentUrl\\\":\\\"https://images.samsung.com/is/content/samsung/assets/es/home/04-2026/2026-vd-2nd-handsaiser-feature-kv-pc.mp4\\\"},{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"WebPage\\\",\\\"name\\\":\\\"Samsung España | Móviles | Televisores | Electrodomésticos\\\",\\\"@id\\\":\\\"https://www.samsung.com/es/#webpage\\\",\\\"description\\\":\\\"Bienvenido a Samsung