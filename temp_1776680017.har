            "text": "<!DOCTYPE html>\n\n<html lang=\"es-ES\">\n    \n    <head>\n    \n    <!-- PWA - manifest\n    <link rel=\"manifest\" href=\"/etc.clientlibs/samsung/clientlibs/consumer/global/clientlib-common/resources/pwa/manifest/es.json\">\n     -->\n    <!-- PWA - Browser Compatible\n    <script async src=\"/etc.clientlibs/samsung/clientlibs/consumer/global/clientlib-common/resources/pwa/js/pwacompat.js\"></script>\n     -->\n    <!-- <meta name=\"theme-color\" content=\"#0c4da2\"> -->\n    <!-- Add to home screen for Safari on iOS -->\n    <!-- <meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n    <meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black\">\n    <meta name=\"apple-mobile-web-app-title\" content=\"Samsung Shop\">\n    <link rel=\"apple-touch-icon\" href=\"/etc.clientlibs/samsung/clientlibs/consumer/global/clientlib-common/resources/pwa/icon/pwa_icon_192x192.png\"> -->\n    <!-- Add to home screen for Windows -->\n    <!-- <meta name=\"msapplication-TileImage\" content=\"/etc.clientlibs/samsung/clientlibs/consumer/global/clientlib-common/resources/pwa/icon/pwa_icon_192x192.png\">\n    <meta name=\"msapplication-TileColor\" content=\"#000000\"> -->\n    \n    \n    \n        <link rel=\"preconnect\" href=\"https://images.samsung.com\"/>\n    \n    \n    \n    \n    <!--  \n    일단 preload는 가이드에 언급된것이 \n\n        /etc.clientlibs/samsung/clientlibs/consumer/global/clientlib-base-ux2.min.js\n        /etc.clientlibs/samsung/clientlibs/consumer/global/clientlib-dependencies.min.js\n        두가지 입니다. \n        \n        PF한정 추가 \n        https://www.samsung.com/etc.clientlibs/samsung/components/content/consumer/global/product/pd-g-product-finder-ux2/clientlibs/site.min.js\n        https://www.samsung.com/etc.clientlibs/samsung/clientlibs/consumer/global/clientlib-templates/page-pf-ux2/compact.min.js\n\n    -->\n    \n    <!-- \n    \n    \n    \n\n     -->\n \n    \n    <!-- Load clientLibs required when initializing Authoring: head.html override required to be added! -->\n    \n    <!-- Load clientLibs required when initializing Authoring: head.html override required to be added! -->\n    \n\n    \n    \n    \r\n\r\n\t<meta charset=\"utf-8\"/>\r\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\"/>\r\n    <meta http-equiv=\"content-type\" content=\"text/html; charset=UTF-8\"/>\r\n\t\r\n\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/>\r\n\t<!-- SEO -->\r\n\t\r\n\t\r\n    \n\t\n\t\n\t\t<title>Samsung España | Móviles | Televisores | Electrodomésticos</title>\n\t\n\t\n\t\n\t\t<meta name=\"title\" content=\"Samsung España | Móviles | Televisores | Electrodomésticos\"/>\n\t\n\t\n\t<meta name=\"google-site-verification\" content=\"_iPyhwSjCAikYelaiP0ebhiXWhyEua3Dr8XQs5uSb8s\"/>\n\t<meta name=\"facebook-domain-verification\"/>\n\t\n\r\n    \r\n\t<link rel=\"canonical\" href=\"https://www.samsung.com/es/\"/>\r\n\t\r\n\t\r\n\t<meta name=\"keywords\" content=\" ES Home Page\"/>\r\n\t<meta name=\"description\" content=\"Bienvenido a Samsung. Descubre nuestros dispositivos con la tecnología más vanguardista. Televisores, smartphones, tablets, electrodomésticos y mucho más.\n\"/>\r\n\t<meta name=\"date\" content=\"2026-04-15\"/>\r\n\t<meta name=\"sitecode\" content=\"es\"/>\r\n\t\r\n\t\r\n\t\r\n\t\t\r\n\t\t\t\r\n\t\t\r\n\t\t \r\n\t\t\r\n\t\r\n\t\r\n\t\r\n\t\r\n\t\r\n\t<meta name=\"twitter:card\" content=\"Summary\"/>\r\n\t<meta name=\"twitter:site\" content=\"@SamsungEspana\"/>\r\n\t<meta name=\"twitter:creator\" content=\"@SamsungEspana\"/>\r\n\t<meta name=\"twitter:url\" content=\"https://www.samsung.com/es/\"/>\r\n\t<meta name=\"twitter:title\" content=\"Samsung España | Móviles | Televisores | Electrodomésticos\"/>\r\n\t<meta name=\"twitter:description\" content=\"Bienvenido a Samsung. Descubre nuestros dispositivos con la tecnología más vanguardista. Televisores, smartphones, tablets, electrodomésticos y mucho más.\n\"/>\r\n\t<meta name=\"twitter:image\" cont